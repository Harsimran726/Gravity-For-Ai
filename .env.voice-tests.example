# Copy only these entries into .env.local. Never expose keys through NEXT_PUBLIC_*.
# This enables read-only analytics; it does not enable outbound calls.
VOICE_TEST_ANALYTICS_ENABLED=false
RASEN_API_KEY=
RASEN_TEST_AGENT_ID=
# Current API reference uses api.rasen.ai. Older guides use api.v2.rasen.ai.
# Both official /v1 hosts are accepted. Confirm the endpoint for your workspace.
RASEN_API_BASE=https://api.rasen.ai/v1

# Reuse the existing server key if already configured; do not overwrite it with a blank value.
SARVAM_API_KEY=
SARVAM_ANALYTICS_ORG_ID=
SARVAM_ANALYTICS_WORKSPACE_ID=
SARVAM_TEST_APP_ID=
