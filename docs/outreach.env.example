# Merge into the deployment environment. Do not commit actual passwords/tokens.
# Keep false until database upgrade, inbox checks and expected-recipient test pass.
OUTREACH_SENDING_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@gravityforai.com
SMTP_FROM=contact@gravityforai.com
SMTP_PASS=
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=
OUTREACH_PUBLIC_URL=https://www.gravityforai.com
# Full business mailing address, including street/PO box and postal code.
OUTREACH_POSTAL_ADDRESS=
# Separate random secrets of at least 32 characters each.
OUTREACH_CRON_SECRET=
OUTREACH_UNSUBSCRIBE_SECRET=
OUTREACH_MAILBOX_DAILY_LIMIT=20
# Existing application configuration also required:
DATABASE_URL=
NEXTAUTH_SECRET=
