# Merge into the existing deployment environment. Never commit real values.
WORKSHOP_CHECKOUT_ENABLED=false
WORKSHOP_SITE_ORIGIN=https://gravityforai.com
# Production: matching rzp_live_ key pair. Local/Preview: test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret shared with the Razorpay live webhook configuration.
RAZORPAY_WEBHOOK_SECRET=
# Random, at least 32 characters. Keep stable across deployments.
WORKSHOP_ACCESS_SECRET=
WORKSHOP_WHATSAPP_GROUP_URL=
WORKSHOP_DEMO_VIDEO_URL=
# Existing DATABASE_URL and existing SMTP configuration are also required.
